## BANCO DO DOCKER COMPOSE (só para desenvolvimento local; troque a senha se quiser)
POSTGRES_DB=sentry
POSTGRES_USER=sentry
POSTGRES_PASSWORD=sentry-local

## DATABASE APPLICATION VARIABLES
# Usadas só quando a aplicação roda fora do Compose (o Compose monta a partir de POSTGRES_*).
DB_URL=jdbc:postgresql://localhost:5432/sentry
DB_USERNAME=sentry
DB_PASSWORD=sentry-local

## ARGON2ID (opcional; padrão e mínimo são os da OWASP: 19456 KiB, 2 iterações, paralelismo 1)
# SENTRY_SECURITY_PASSWORD_ARGON2_MEMORY=19456
# SENTRY_SECURITY_PASSWORD_ARGON2_ITERATIONS=2
# SENTRY_SECURITY_PASSWORD_ARGON2_PARALLELISM=1

## ADMINISTRADOR CRIADO NA PRIMEIRA SUBIDA DO sentry-auth (banco vazio)
# Sem SENTRY_ADMIN_PASSWORD, uma senha de 24 caracteres é gerada e aparece uma única vez no log.
SENTRY_ADMIN_USERNAME=admin
SENTRY_ADMIN_EMAIL=admin@sentry.local
SENTRY_ADMIN_PASSWORD=

## URL PÚBLICA DO sentry-auth, usada como issuer dos tokens (F1-07)
SENTRY_ISSUER_URL=http://localhost:8081

## TELA DE LOGIN DO FRONT-END (React), na mesma origem do sentry-auth por um proxy
# Sem sessão, o /oauth2/authorize redireciona o navegador para cá
SENTRY_LOGIN_URL=http://localhost:5173/login

## CHAVE DE ASSINATURA DOS TOKENS (RS256, F1-07)
# Chave privada RSA em PEM (PKCS#8): o conteúdo ou o caminho do arquivo montado (file:/run/secrets/signing-key.pem).
# Gerar: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out signing-key.pem
SENTRY_JWT_SIGNING_KEY=
# Chave anterior, mantida no JWKS durante a troca para que tokens antigos validem até expirar
SENTRY_JWT_PREVIOUS_KEY=
# Só em desenvolvimento: sem chave, gera uma temporária a cada subida. Em produção deixe false
SENTRY_JWT_GENERATE_IF_MISSING=true

## LDAP (RN-F1-02.7): confere a senha dos usuários com authentication_type = LDAP. Vazio desliga o LDAP
# Use ldaps:// (ou StartTLS) em produção: a senha do usuário vai no bind
SENTRY_LDAP_URL=
# DN base, ex.: dc=exemplo,dc=com
SENTRY_LDAP_BASE=
# DN do usuário relativo à base; {0} é o username cadastrado no Sentry
SENTRY_LDAP_USER_DN_PATTERN=uid={0},ou=people
# Active Directory (usuários em várias OUs): com filtro, a conta de serviço busca o usuário e o DN acima é ignorado.
# A base da busca é relativa ao SENTRY_LDAP_BASE. Ex.: SENTRY_LDAP_BASE=DC=exemplo,DC=com e
# SENTRY_LDAP_USER_SEARCH_BASE=OU=Usuarios, SENTRY_LDAP_USER_SEARCH_FILTER=(&(objectClass=person)(sAMAccountName={0}))
SENTRY_LDAP_USER_SEARCH_BASE=
SENTRY_LDAP_USER_SEARCH_FILTER=
# Conta de serviço só de leitura, ex.: svc-sentry@exemplo.com
SENTRY_LDAP_MANAGER_DN=
SENTRY_LDAP_MANAGER_PASSWORD=
