## DATABASE APPLICATION VARIABLES
DB_URL=
DB_USERNAME=
DB_PASSWORD=
## ARGON2ID (opcional; padrão e mínimo são os da OWASP: 19456 KiB, 2 iterações, paralelismo 1)
# SENTRY_SECURITY_PASSWORD_ARGON2_MEMORY=19456
# SENTRY_SECURITY_PASSWORD_ARGON2_ITERATIONS=2
# SENTRY_SECURITY_PASSWORD_ARGON2_PARALLELISM=1

## ADMINISTRADOR CRIADO NA PRIMEIRA SUBIDA DO sentry-auth (banco vazio)
# Sem SENTRY_ADMIN_PASSWORD, uma senha de 24 caracteres é gerada e aparece uma única vez no log.
SENTRY_ADMIN_USERNAME=admin
SENTRY_ADMIN_EMAIL=admin@sentry.local
SENTRY_ADMIN_PASSWORD=
